# ── Application ──────────────────────────────────────────────
NODE_ENV=development
# HTTP API (producer)
PORT=3000
# Worker health/metrics port
WORKER_HTTP_PORT=3001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
LOG_PRETTY=false
SHUTDOWN_TIMEOUT_MS=30000

# ── MySQL 8 (certificate status) — required ──────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=app
DB_POOL_MIN=0
DB_POOL_MAX=10
# docker-compose runs migrations once in the `migrate` service; keep false there
DB_MIGRATE_ON_START=false

# ── RabbitMQ — required ──────────────────────────────────────
RABBITMQ_URL=amqp://localhost:5672
# Unacknowledged messages a worker may hold at once
RABBITMQ_PREFETCH=10
RABBITMQ_CONNECT_RETRIES=10
RABBITMQ_CONNECT_RETRY_DELAY_MS=1000

# ── External PDF API (flaky chaos server locally) — required ─
PDF_API_URL=http://localhost:4000

# ── Circuit breaker (opossum) ────────────────────────────────
CB_TIMEOUT_MS=10000
CB_ERROR_THRESHOLD_PERCENTAGE=50
CB_RESET_TIMEOUT_MS=30000
CB_VOLUME_THRESHOLD=5
CB_ROLLING_WINDOW_MS=10000

# ── Retries: delay = base × multiplier^(n-1) → 1 s, 4 s, 16 s ─
RETRY_MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
RETRY_MULTIPLIER=4
# While the breaker is open messages are parked (no attempt consumed)
DEFER_DELAY_MS=30000
MAX_DEFERRALS=120

# ── Dead Letter Queue ────────────────────────────────────────
DLQ_ALARM_NAME=certificate-dlq-depth
# Alarm fires when the DLQ holds more than this many messages
DLQ_ALARM_THRESHOLD=0
DLQ_ALARM_INTERVAL_MS=15000
REPROCESS_DEFAULT_LIMIT=100
REPROCESS_MAX_LIMIT=1000

# ── docker-compose host ports (change if taken) ──────────────
MYSQL_HOST_PORT=3306
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
FLAKY_PDF_HOST_PORT=4000
API_HOST_PORT=3000
WORKER_HOST_PORT=3001
