{
  "name": "resilient-pdf-worker",
  "version": "1.0.0",
  "description": "RabbitMQ worker that generates PDF certificates and never loses a message when the external PDF API fails: retries with exponential backoff, circuit breaker, Dead Letter Queue and DLQ alarm.",
  "main": "dist/index.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:chaos": "tsx watch chaos/flaky-pdf-server.ts",
    "build": "rimraf dist && tsc",
    "build:chaos": "rimraf dist-chaos && tsc -p tsconfig.chaos.json",
    "start": "node dist/index.js",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/presentation/cli/migrate.ts",
    "migrate:rollback": "tsx src/presentation/cli/migrate.ts --rollback",
    "seed": "tsx scripts/seed.ts",
    "chaos:demo": "tsx scripts/chaos-demo.ts",
    "bench": "tsx benchmarks/run-benchmark.ts",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/ scripts/ chaos/ benchmarks/ --max-warnings 0",
    "format": "prettier --write \"{src,tests,scripts,chaos,benchmarks}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests,scripts,chaos,benchmarks}/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "bench:chaos": "tsx benchmarks/chaos-verification.ts"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "knex": "^3.1.0",
    "mysql2": "^3.14.0",
    "opossum": "^10.0.0",
    "pino": "^9.14.0",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testcontainers/mysql": "^12.2.0",
    "@testcontainers/rabbitmq": "^12.2.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^6.0.3",
    "commander": "^14.0.3",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "rimraf": "^5.0.10",
    "supertest": "^7.1.0",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0"
  }
}
